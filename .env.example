# Dev, API/tools entry points and chain deploy/seed/smoke load the root .env.
# Existing shell variables take precedence. Defaults need no credentials.
REGISTRY_MODE=demo
API_PORT=4000
TOOLS_PORT=4100
WEB_PORT=3000
TOOL_SERVER_URL=http://127.0.0.1:4100
WEB_ORIGIN=http://localhost:3000
# Optional: change together for API and tools when starting them separately.
# pnpm dev generates a fresh random token automatically when this is unset.
# TOOL_AUTH_TOKEN=
# On-chain mode: start local Hardhat, deploy, seed, then REGISTRY_MODE=onchain.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# CHAIN_ID is required for remote RPCs and must match eth_chainId.
# REGISTRY_ADDRESS=0x...
# Default file: localhost.json for 31337, otherwise <CHAIN_ID>.json.
# If both address and file are explicit, they must agree.
# REGISTRY_DEPLOYMENT=packages/contracts/deployments/localhost.json
# DEPLOYER_PRIVATE_KEY= (only needed for deployment outside the local demo chain)
